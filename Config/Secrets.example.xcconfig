// Copy this file to Config/Secrets.xcconfig (same folder) and fill in a value.
// Secrets.xcconfig is in .gitignore — it will never be committed.
//
// This is a DEV CONVENIENCE ONLY (e.g. for Simulator runs where Keychain
// entry is annoying). The app's real, recommended flow is to type the key
// into Settings at runtime, where it is stored in the iOS Keychain — see
// MaskLens/Config/APIKeyStore.swift. Nothing here is required for that path.
//
// If you do use this file, it's read at build time and copied into
// Info.plist as ANTHROPIC_API_KEY_DEV, which AppSettings.swift falls back to
// only when Keychain is empty. Do not ship a build with a real key baked in
// this way — Info.plist is trivially readable inside the .ipa.

ANTHROPIC_API_KEY_DEV = your-key-here
